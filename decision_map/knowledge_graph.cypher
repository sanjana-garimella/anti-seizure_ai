// Aim 2 knowledge graph - Neo4j import (DRAFT / simulated).
// Idempotent: MERGE on id. Run:  cat knowledge_graph.cypher | cypher-shell
CREATE CONSTRAINT aim2_node_id IF NOT EXISTS FOR (n:Node) REQUIRE n.id IS UNIQUE;

MERGE (n:Node:Recommendation {id: 'cat_no_change'}) SET n += {id: 'cat_no_change', label: 'Keep current dose', type: 'recommendation', layer: 5, detail: 'Engine recommendation: Keep current dose.'};
MERGE (n:Node:Recommendation {id: 'cat_escalate'}) SET n += {id: 'cat_escalate', label: 'Increase the dose', type: 'recommendation', layer: 5, detail: 'Engine recommendation: Increase the dose.'};
MERGE (n:Node:Recommendation {id: 'cat_slower_uptitration'}) SET n += {id: 'cat_slower_uptitration', label: 'Increase more slowly', type: 'recommendation', layer: 5, detail: 'Engine recommendation: Increase more slowly.'};
MERGE (n:Node:Recommendation {id: 'cat_hold'}) SET n += {id: 'cat_hold', label: 'Hold at current dose', type: 'recommendation', layer: 5, detail: 'Engine recommendation: Hold at current dose.'};
MERGE (n:Node:Recommendation {id: 'cat_lower_dose'}) SET n += {id: 'cat_lower_dose', label: 'Lower the dose', type: 'recommendation', layer: 5, detail: 'Engine recommendation: Lower the dose.'};
MERGE (n:Node:Recommendation {id: 'cat_add_medication'}) SET n += {id: 'cat_add_medication', label: 'Add another medicine', type: 'recommendation', layer: 5, detail: 'Engine recommendation: Add another medicine.'};
MERGE (n:Node:Recommendation {id: 'cat_switch_medication'}) SET n += {id: 'cat_switch_medication', label: 'Switch medicine', type: 'recommendation', layer: 5, detail: 'Engine recommendation: Switch medicine.'};
MERGE (n:Node:Recommendation {id: 'cat_insufficient_data'}) SET n += {id: 'cat_insufficient_data', label: 'Need more info / defer', type: 'recommendation', layer: 5, detail: 'Engine recommendation: Need more info / defer.'};
MERGE (n:Node:Input {id: 'survey'}) SET n += {id: 'survey', label: 'Between-visit survey', type: 'input', layer: 0, detail: 'Interval check-in: seizures since last visit? side effects (level)? phase? adherence? duration/frequency? rash? dose goal? (kristen/BetweenVisit_SurveyDraft)'};
MERGE (n:Node:Branch {id: 'branch_bt'}) SET n += {id: 'branch_bt', label: 'BREAKTHROUGH seizures', type: 'branch', layer: 2, detail: 'One or more breakthrough seizures this interval.'};
MERGE (n:Node:Branch {id: 'branch_sf'}) SET n += {id: 'branch_sf', label: 'SEIZURE-FREE', type: 'branch', layer: 2, detail: 'No seizures this interval.'};
MERGE (n:Node:Rule {id: 'rule_R0'}) SET n += {id: 'rule_R0', label: 'R0 · Spreading/blistering rash', type: 'rule', layer: 1, detail: 'Serious skin-reaction concern -> stop + switch; urgent review; family message withheld.  Provenance: Barbour T11/T12 (SJS/TEN)', branch: 'safety', provenance: 'Barbour T11/T12 (SJS/TEN)'};
MERGE (n:Node:Rule {id: 'rule_R0b'}) SET n += {id: 'rule_R0b', label: 'R0b · Seizure emergency', type: 'rule', layer: 1, detail: 'Prolonged/repeated seizures -> urgent review; if helping, increase faster; if not helping after min trial -> switch.  Provenance: Barbour T13', branch: 'safety', provenance: 'Barbour T13'};
MERGE (n:Node:Rule {id: 'rule_R0c'}) SET n += {id: 'rule_R0c', label: 'R0c · Other urgent safety', type: 'rule', layer: 1, detail: 'Breathing/ER signal -> withhold automated rec; immediate physician review.  Provenance: safety', branch: 'safety', provenance: 'safety'};
MERGE (n:Node:Rule {id: 'rule_R1'}) SET n += {id: 'rule_R1', label: 'R1 · Dose changed + seizures', type: 'rule', layer: 1, detail: 'Regimen recently changed and seizures continue -> confirm regimen, contact clinic (not enough info).  Provenance: Barbour I4', branch: 'safety', provenance: 'Barbour I4'};
MERGE (n:Node:Rule {id: 'rule_R2'}) SET n += {id: 'rule_R2', label: 'R2 · Stopped (side effects/cost)', type: 'rule', layer: 1, detail: 'Family stopped for a switch-worthy reason -> switch to a better-tolerated/feasible option.  Provenance: Barbour T10', branch: 'safety', provenance: 'Barbour T10'};
MERGE (n:Node:Rule {id: 'rule_R3'}) SET n += {id: 'rule_R3', label: 'R3 · Drug not indicated', type: 'rule', layer: 1, detail: 'Drug does not cover the reported seizure type (e.g. ethosuximide = absence only) -> switch.  Provenance: Barbour T14', branch: 'safety', provenance: 'Barbour T14'};
MERGE (n:Node:Rule {id: 'rule_R4'}) SET n += {id: 'rule_R4', label: 'R4 · Small rash + SJS workup', type: 'rule', layer: 1, detail: 'Small rash on an SJS-risk drug + a workup criterion (ancestry/meds/missed doses/time/no viral illness) -> switch.  Provenance: Barbour T11', branch: 'safety', provenance: 'Barbour T11'};
MERGE (n:Node:Rule {id: 'rule_R4b'}) SET n += {id: 'rule_R4b', label: 'R4b · Can\'t reach min dose (SE)', type: 'rule', layer: 1, detail: 'Side effects prevent even a minimum effective dose -> switch.  Provenance: Barbour 2026-06', branch: 'safety', provenance: 'Barbour 2026-06'};
MERGE (n:Node:Rule {id: 'rule_R5'}) SET n += {id: 'rule_R5', label: 'R5 · Adherence-driven breakthrough', type: 'rule', layer: 1, detail: 'Seizures coincide with missed doses -> support adherence before any dose change.  Provenance: adherence', branch: 'safety', provenance: 'adherence'};
MERGE (n:Node:Rule {id: 'rule_R-defer-se'}) SET n += {id: 'rule_R-defer-se', label: 'R-defer · Unknown SE impact', type: 'rule', layer: 1, detail: 'Side-effect impact answer not recognized -> physician review (no confident rec).  Provenance: E3 defer-on-ambiguity', branch: 'safety', provenance: 'E3 defer-on-ambiguity'};
MERGE (n:Node:Rule {id: 'rule_BT'}) SET n += {id: 'rule_BT', label: 'BT · Breakthrough table', type: 'rule', layer: 3, detail: 'Action by urgency tier x phase x side-effect level. Levels 1-5 route here (L1 only when duration captured).  Provenance: Barbour 2026-06-25; gate fixed 2026-07-08 (Kristen B1/B2/B3)', branch: 'breakthrough', provenance: 'Barbour 2026-06-25; gate fixed 2026-07-08 (Kristen B1/B2/B3)'};
MERGE (n:Node:Rule {id: 'rule_R5b'}) SET n += {id: 'rule_R5b', label: 'R5b · Helping but dose-limited', type: 'rule', layer: 3, detail: 'Medicine helps but side effects block further increases while seizures continue -> ADD a second medicine.  Provenance: Barbour 2026-06', branch: 'breakthrough', provenance: 'Barbour 2026-06'};
MERGE (n:Node:Rule {id: 'rule_R6'}) SET n += {id: 'rule_R6', label: 'R6 · Intolerable SE', type: 'rule', layer: 3, detail: 'Breakthrough + intolerable side effects -> switch.  Provenance: T7 boundary', branch: 'breakthrough', provenance: 'T7 boundary'};
MERGE (n:Node:Rule {id: 'rule_R7'}) SET n += {id: 'rule_R7', label: 'R7 · Family prefers slower', type: 'rule', layer: 3, detail: 'Breakthrough but family prefers a slower/changed dose -> slower uptitration.  Provenance: family preference', branch: 'breakthrough', provenance: 'family preference'};
MERGE (n:Node:Rule {id: 'rule_R8'}) SET n += {id: 'rule_R8', label: 'R8 · No SE, no duration', type: 'rule', layer: 3, detail: 'Breakthrough, no side effects, but duration not captured -> need duration to decide continue vs faster.  Provenance: Barbour T1/T4', branch: 'breakthrough', provenance: 'Barbour T1/T4'};
MERGE (n:Node:Rule {id: 'rule_R9'}) SET n += {id: 'rule_R9', label: 'R9 · Frequent/long -> faster', type: 'rule', layer: 3, detail: 'Frequent and/or long breakthrough -> increase FASTER toward goal (per duration/frequency thresholds).  Provenance: Barbour T1/T4', branch: 'breakthrough', provenance: 'Barbour T1/T4'};
MERGE (n:Node:Rule {id: 'rule_R10'}) SET n += {id: 'rule_R10', label: 'R10 · Short/infrequent titrating', type: 'rule', layer: 3, detail: 'Short/infrequent breakthrough while titrating -> continue the plan (keep increasing on schedule).  Provenance: Barbour T1/T4', branch: 'breakthrough', provenance: 'Barbour T1/T4'};
MERGE (n:Node:Rule {id: 'rule_R11'}) SET n += {id: 'rule_R11', label: 'R11 · Below faster thresholds', type: 'rule', layer: 3, detail: 'Breakthrough below the increase-faster thresholds -> continue the current titration plan.  Provenance: Barbour T1/T4', branch: 'breakthrough', provenance: 'Barbour T1/T4'};
MERGE (n:Node:Rule {id: 'rule_R12g'}) SET n += {id: 'rule_R12g', label: 'R12g · At goal + medium SE', type: 'rule', layer: 3, detail: 'At goal, medium-impact SE, ongoing seizures -> ask family: tolerate & increase, or add a second med.  Provenance: Barbour 2026-06', branch: 'breakthrough', provenance: 'Barbour 2026-06'};
MERGE (n:Node:Rule {id: 'rule_R12'}) SET n += {id: 'rule_R12', label: 'R12 · Manageable, no duration', type: 'rule', layer: 3, detail: 'Breakthrough + manageable SE but no duration -> need duration to weigh increasing vs holding.  Provenance: Barbour', branch: 'breakthrough', provenance: 'Barbour'};
MERGE (n:Node:Rule {id: 'rule_R13'}) SET n += {id: 'rule_R13', label: 'R13 · Titrating + medium SE', type: 'rule', layer: 3, detail: 'Titrating + medium-impact SE -> slow uptitration; reassess after a 1-week adjustment.  Provenance: Barbour 2026-06', branch: 'breakthrough', provenance: 'Barbour 2026-06'};
MERGE (n:Node:Rule {id: 'rule_NS'}) SET n += {id: 'rule_NS', label: 'NS · No-Seizures table', type: 'rule', layer: 3, detail: 'Action by phase x side-effect level when seizure-free. \'Continue\' cells schedule no follow-up (Kristen D4).  Provenance: Barbour 2026-06-25; follow-up fixed 2026-07-08 (Kristen D4)', branch: 'seizure_free', provenance: 'Barbour 2026-06-25; follow-up fixed 2026-07-08 (Kristen D4)'};
MERGE (n:Node:Rule {id: 'rule_R14'}) SET n += {id: 'rule_R14', label: 'R14 · Free + intolerable SE', type: 'rule', layer: 3, detail: 'Seizure-free but intolerable side effects -> switch.  Provenance: legacy', branch: 'seizure_free', provenance: 'legacy'};
MERGE (n:Node:Rule {id: 'rule_R15'}) SET n += {id: 'rule_R15', label: 'R15 · Family wants different med', type: 'rule', layer: 3, detail: 'Family would like a different medicine (no clinical trigger) -> offer switch options for physician.  Provenance: family preference', branch: 'seizure_free', provenance: 'family preference'};
MERGE (n:Node:Rule {id: 'rule_R16'}) SET n += {id: 'rule_R16', label: 'R16 · Free titrating, family slower', type: 'rule', layer: 3, detail: 'Seizure-free, titrating, family prefers slower -> slower uptitration.  Provenance: family preference', branch: 'seizure_free', provenance: 'family preference'};
MERGE (n:Node:Rule {id: 'rule_R17'}) SET n += {id: 'rule_R17', label: 'R17 · Free + manageable SE', type: 'rule', layer: 3, detail: 'Seizure-free + manageable side effects -> no change; reassess as body adjusts.  Provenance: legacy', branch: 'seizure_free', provenance: 'legacy'};
MERGE (n:Node:Rule {id: 'rule_R18'}) SET n += {id: 'rule_R18', label: 'R18 · Free + no SE', type: 'rule', layer: 3, detail: 'Seizure-free, no side effects -> no change; recheck on schedule if still titrating.  Provenance: legacy', branch: 'seizure_free', provenance: 'legacy'};
MERGE (n:Node:SideEffectLevel {id: 'lvl0'}) SET n += {id: 'lvl0', label: 'L0 none', type: 'level', layer: 4, detail: 'Side-effect impact level 0.'};
MERGE (n:Node:SideEffectLevel {id: 'lvl1'}) SET n += {id: 'lvl1', label: 'L1 small', type: 'level', layer: 4, detail: 'Side-effect impact level 1.'};
MERGE (n:Node:SideEffectLevel {id: 'lvl2'}) SET n += {id: 'lvl2', label: 'L2 med-tol', type: 'level', layer: 4, detail: 'Side-effect impact level 2.'};
MERGE (n:Node:SideEffectLevel {id: 'lvl3'}) SET n += {id: 'lvl3', label: 'L3 med-alot', type: 'level', layer: 4, detail: 'Side-effect impact level 3.'};
MERGE (n:Node:SideEffectLevel {id: 'lvl4'}) SET n += {id: 'lvl4', label: 'L4 big', type: 'level', layer: 4, detail: 'Side-effect impact level 4.'};
MERGE (n:Node:SideEffectLevel {id: 'lvl5'}) SET n += {id: 'lvl5', label: 'L5 not-fit', type: 'level', layer: 4, detail: 'Side-effect impact level 5.'};
MERGE (n:Node:Phase {id: 'phase_titrating'}) SET n += {id: 'phase_titrating', label: 'titrating', type: 'phase', layer: 4, detail: 'Titration phase: titrating.'};
MERGE (n:Node:Phase {id: 'phase_holding'}) SET n += {id: 'phase_holding', label: 'holding', type: 'phase', layer: 4, detail: 'Titration phase: holding.'};
MERGE (n:Node:Phase {id: 'phase_steady'}) SET n += {id: 'phase_steady', label: 'steady', type: 'phase', layer: 4, detail: 'Titration phase: steady.'};
MERGE (n:Node:Table {id: 'tbl_no_seizures'}) SET n += {id: 'tbl_no_seizures', label: 'No-Seizures table', type: 'table', layer: 4, detail: 'Action by phase x level when seizure-free. verified=False'};
MERGE (n:Node:Table {id: 'tbl_bt_non_urgent'}) SET n += {id: 'tbl_bt_non_urgent', label: 'Breakthrough · non-urgent', type: 'table', layer: 4, detail: 'titrating: stay | stay | stay | hold | add med | switch holding: stay | increase | increase | hold | add med | switch steady: increase | increase | increase | increase | add med | switch verified=False'};
MERGE (n:Node:Table {id: 'tbl_bt_urgent'}) SET n += {id: 'tbl_bt_urgent', label: 'Breakthrough · urgent', type: 'table', layer: 4, detail: 'titrating: increase | increase | increase | increase | add med | switch holding: increase | increase | increase | increase | add med | switch steady: increase | increase | increase | increase | add med | switch verified=False'};
MERGE (n:Node:Table {id: 'tbl_bt_emergent'}) SET n += {id: 'tbl_bt_emergent', label: 'Breakthrough · emergent', type: 'table', layer: 4, detail: 'titrating: increase | increase | increase | increase | add med | switch holding: increase | increase | increase | increase | add med | switch steady: increase | increase | increase | increase | add med | switch verified=False'};
MERGE (n:Node:Table {id: 'tbl_urgency'}) SET n += {id: 'tbl_urgency', label: 'Urgency thresholds', type: 'table', layer: 4, detail: 'Per seizure-type duration/frequency cutoffs -> breakthrough tier. verified=False'};
MERGE (n:Node:Table {id: 'ladder_hub'}) SET n += {id: 'ladder_hub', label: 'Dose ladder', type: 'table', layer: 4, detail: 'Per drug x band explicit rungs (min-maint -> eff-max -> max; high range -> † labs). Barbour final_doses v6, DRAFT.'};
MERGE (n:Node:Drug {id: 'drug_levetiracetam'}) SET n += {id: 'drug_levetiracetam', label: 'Levetiracetam', type: 'drug', layer: 4, detail: 'Levetiracetam (Keppra) SJS risk: False Behavioral/psychiatric effects (irritability, mood, aggression). Avoid in significant behavioral comorbidity (Barbour). Renally cleared.'};
MERGE (n:Node:Band {id: 'band_levetiracetam_0'}) SET n += {id: 'band_levetiracetam_0', label: 'Levetiracetam · Children ≥2 years and Adults', type: 'band', layer: 4, detail: 'Children ≥2 years and Adults initial 10 mg/kg/day min-maint 30 mg/kg/day -> eff-max 60 -> max 3000.0 mg/d up 6 · higher(†) 0'};
MERGE (n:Node:Drug {id: 'drug_lamotrigine'}) SET n += {id: 'drug_lamotrigine', label: 'Lamotrigine', type: 'drug', layer: 4, detail: 'Lamotrigine (Lamictal) SJS risk: True BOXED WARNING: serious rash (SJS/TEN). Risk increased by concomitant valproate, by exceeding the initial dose, and by escalating faster than recommended. Slow titration is essential. Titration is CONC'};
MERGE (n:Node:Band {id: 'band_lamotrigine_0'}) SET n += {id: 'band_lamotrigine_0', label: 'Lamotrigine · Children 2–12 years', type: 'band', layer: 4, detail: 'Children 2–12 years initial 0.3 mg/kg/day min-maint 4.5 mg/kg/day -> eff-max 6.3 -> max 300.0 mg/d up 3 · higher(†) 3'};
MERGE (n:Node:Band {id: 'band_lamotrigine_1'}) SET n += {id: 'band_lamotrigine_1', label: 'Lamotrigine · Adolescents 12–16 years', type: 'band', layer: 4, detail: 'Adolescents 12–16 years initial 25 mg/day min-maint 150 mg/day -> eff-max 280 -> max 400.0 mg/d up 3 · higher(†) 3'};
MERGE (n:Node:Band {id: 'band_lamotrigine_2'}) SET n += {id: 'band_lamotrigine_2', label: 'Lamotrigine · >16 years', type: 'band', layer: 4, detail: '>16 years initial 25 mg/day min-maint 200 mg/day -> eff-max 360 -> max 500.0 mg/d up 3 · higher(†) 3'};
MERGE (n:Node:Drug {id: 'drug_topiramate'}) SET n += {id: 'drug_topiramate', label: 'Topiramate', type: 'drug', layer: 4, detail: 'Topiramate (Topamax) SJS risk: False Cognitive/word-finding; metabolic acidosis; oligohidrosis; nephrolithiasis.'};
MERGE (n:Node:Band {id: 'band_topiramate_0'}) SET n += {id: 'band_topiramate_0', label: 'Topiramate · ≤11 kg', type: 'band', layer: 4, detail: '≤11 kg initial 25 mg/day min-maint 150 mg/day -> eff-max 220 -> max 250.0 mg/d up 4 · higher(†) 2'};
MERGE (n:Node:Band {id: 'band_topiramate_1'}) SET n += {id: 'band_topiramate_1', label: 'Topiramate · 12–22 kg', type: 'band', layer: 4, detail: '12–22 kg initial 25 mg/day min-maint 200 mg/day -> eff-max 270 -> max 300.0 mg/d up 3 · higher(†) 2'};
MERGE (n:Node:Band {id: 'band_topiramate_2'}) SET n += {id: 'band_topiramate_2', label: 'Topiramate · 23–38 kg', type: 'band', layer: 4, detail: '23–38 kg initial 25 mg/day min-maint 200 mg/day -> eff-max 305 -> max 350.0 mg/d up 4 · higher(†) 2'};
MERGE (n:Node:Band {id: 'band_topiramate_3'}) SET n += {id: 'band_topiramate_3', label: 'Topiramate · >38 kg', type: 'band', layer: 4, detail: '>38 kg initial 50 mg/day min-maint 250 mg/day -> eff-max 355 -> max 400.0 mg/d up 4 · higher(†) 2'};
MERGE (n:Node:LabPanel {id: 'labs_topiramate'}) SET n += {id: 'labs_topiramate', label: '† labs Topiramate', type: 'labs', layer: 4, detail: 'High-dose labs: - CBC - CMP - TSH - vitamin D - topiramate level'};
MERGE (n:Node:Drug {id: 'drug_oxcarbazepine'}) SET n += {id: 'drug_oxcarbazepine', label: 'Oxcarbazepine', type: 'drug', layer: 4, detail: 'Oxcarbazepine (Trileptal) SJS risk: True Hyponatremia; rash with HLA-B*1502 cross-reactivity. Spreading/blistering rash -> stop + switch.'};
MERGE (n:Node:Band {id: 'band_oxcarbazepine_0'}) SET n += {id: 'band_oxcarbazepine_0', label: 'Oxcarbazepine · <20 kg', type: 'band', layer: 4, detail: '<20 kg initial 7.5 mg/kg/day min-maint 7.5 mg/kg/day -> eff-max 44.25 -> max 900.0 mg/d up 7 · higher(†) 3'};
MERGE (n:Node:Band {id: 'band_oxcarbazepine_1'}) SET n += {id: 'band_oxcarbazepine_1', label: 'Oxcarbazepine · 20 to <25 kg', type: 'band', layer: 4, detail: '20 to <25 kg initial 300 mg/day min-maint 600 mg/day -> eff-max 810 -> max 900.0 mg/d up 4 · higher(†) 2'};
MERGE (n:Node:Band {id: 'band_oxcarbazepine_2'}) SET n += {id: 'band_oxcarbazepine_2', label: 'Oxcarbazepine · 25 to <35 kg', type: 'band', layer: 4, detail: '25 to <35 kg initial 300 mg/day min-maint 900 mg/day -> eff-max 1110 -> max 1200.0 mg/d up 4 · higher(†) 2'};
MERGE (n:Node:Band {id: 'band_oxcarbazepine_3'}) SET n += {id: 'band_oxcarbazepine_3', label: 'Oxcarbazepine · 35 to <45 kg', type: 'band', layer: 4, detail: '35 to <45 kg initial 300 mg/day min-maint 900 mg/day -> eff-max 1320 -> max 1500.0 mg/d up 4 · higher(†) 2'};
