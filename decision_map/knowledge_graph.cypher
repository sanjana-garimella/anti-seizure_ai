MERGE (n:Node:Band {id: 'band_carbamazepine_2'}) SET n += {id: 'band_carbamazepine_2', label: 'Carbamazepine · Adolescents 13–18 years', type: 'band', layer: 4, detail: 'Adolescents 13–18 years initial 400 mg/day min-maint 800 mg/day -> eff-max 1040 -> max 1200.0 mg/d up 3 · higher(†) 2'};
MERGE (n:Node:Band {id: 'band_carbamazepine_3'}) SET n += {id: 'band_carbamazepine_3', label: 'Carbamazepine · Adults >18 years', type: 'band', layer: 4, detail: 'Adults >18 years initial 400 mg/day min-maint 800 mg/day -> eff-max 1760 -> max 2000.0 mg/d up 9 · higher(†) 3'};
MERGE (n:Node:LabPanel {id: 'labs_carbamazepine'}) SET n += {id: 'labs_carbamazepine', label: '† labs Carbamazepine', type: 'labs', layer: 4, detail: 'High-dose labs: - CBC - CMP - LFTs - TSH - vitamin D - carbamazepine level'};
MERGE (n:Node:Drug {id: 'drug_valproic_acid'}) SET n += {id: 'drug_valproic_acid', label: 'Valproic acid', type: 'drug', layer: 4, detail: 'Valproic acid (Depakene; cf. divalproex/Depakote) SJS risk: False Hepatotoxicity; pancreatitis; thrombocytopenia; teratogenic. Raises lamotrigine levels (rash risk).'};
