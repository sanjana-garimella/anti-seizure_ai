MERGE (n:Node:Band {id: 'band_oxcarbazepine_5'}) SET n += {id: 'band_oxcarbazepine_5', label: 'Oxcarbazepine · 50 to <60 kg', type: 'band', layer: 4, detail: '50 to <60 kg initial 300 mg/day min-maint 1200 mg/day -> eff-max 1620 -> max 1800.0 mg/d up 4 · higher(†) 2'};
MERGE (n:Node:Band {id: 'band_oxcarbazepine_6'}) SET n += {id: 'band_oxcarbazepine_6', label: 'Oxcarbazepine · 60 to <70 kg', type: 'band', layer: 4, detail: '60 to <70 kg initial 300 mg/day min-maint 1200 mg/day -> eff-max 1830 -> max 2100.0 mg/d up 6 · higher(†) 3'};
MERGE (n:Node:Band {id: 'band_oxcarbazepine_7'}) SET n += {id: 'band_oxcarbazepine_7', label: 'Oxcarbazepine · ≥70 kg', type: 'band', layer: 4, detail: '≥70 kg initial 300 mg/day min-maint 1500 mg/day -> eff-max 2100 -> max 2100.0 mg/d up 6 · higher(†) 0'};
MERGE (n:Node:LabPanel {id: 'labs_oxcarbazepine'}) SET n += {id: 'labs_oxcarbazepine', label: '† labs Oxcarbazepine', type: 'labs', layer: 4, detail: 'High-dose labs: - CBC - CMP - LFTs - TSH - vitamin D - oxcarbazepine level'};
MERGE (n:Node:Drug {id: 'drug_carbamazepine'}) SET n += {id: 'drug_carbamazepine', label: 'Carbamazepine', type: 'drug', layer: 4, detail: 'Carbamazepine (Tegretol) SJS risk: True Serious rash (SJS/TEN), esp. with HLA-B*1502 (Southeast/East Asian ancestry). Hyponatremia; blood dyscrasias; enzyme inducer.'};
MERGE (n:Node:Band {id: 'band_carbamazepine_0'}) SET n += {id: 'band_carbamazepine_0', label: 'Carbamazepine · Children 2 to <6 years', type: 'band', layer: 4, detail: 'Children 2 to <6 years initial 10 mg/kg/day min-maint 10 mg/kg/day -> eff-max 25 -> max 800.0 mg/d up 3 · higher(†) 2'};
