		{"id":"n22","type":"text","x":864,"y":660,"width":200,"height":52,"text":"L4\nBig impact","color":"2"},
		{"id":"n23","type":"text","x":1080,"y":660,"width":200,"height":52,"text":"L5\nNot a fit","color":"1"},
		{"id":"n24","type":"text","x":0,"y":752,"width":1280,"height":30,"text":"▸ Still Titrating (A6)","color":"6"},
