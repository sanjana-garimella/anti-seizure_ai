		{"id":"n49","type":"text","x":712,"y":1468,"width":300,"height":46,"text":"URGENT  (duration OR frequency)","color":"1"},
		{"id":"n50","type":"text","x":0,"y":1528,"width":380,"height":56,"text":"A. Staring spells (absence)","color":"2"},
		{"id":"n51","type":"text","x":396,"y":1528,"width":300,"height":56,"text":"<90s  &  <10/day","color":"4"},
		{"id":"n52","type":"text","x":712,"y":1528,"width":300,"height":56,"text":"≥90s  OR  ≥10/day","color":"1"},
		{"id":"n53","type":"text","x":0,"y":1592,"width":380,"height":56,"text":"B. Jerks (myoclonic)","color":"2"},
		{"id":"n54","type":"text","x":396,"y":1592,"width":300,"height":56,"text":"<20s  &  <10/day","color":"4"},
		{"id":"n55","type":"text","x":712,"y":1592,"width":300,"height":56,"text":"≥20s  OR  ≥10/day","color":"1"},
		{"id":"n56","type":"text","x":0,"y":1656,"width":380,"height":56,"text":"C. Whole-body stiffen/shake (tonic-clonic)","color":"2"},
		{"id":"n57","type":"text","x":396,"y":1656,"width":300,"height":56,"text":"<30s  &  <1 per 4 wks","color":"4"},
		{"id":"n58","type":"text","x":712,"y":1656,"width":300,"height":56,"text":"≥30s  OR  ≥1 per 4 wks","color":"1"},
		{"id":"n59","type":"text","x":0,"y":1720,"width":380,"height":56,"text":"D. One part stiffen/shake (focal motor)","color":"2"},
		{"id":"n60","type":"text","x":396,"y":1720,"width":300,"height":56,"text":"<3 min  &  <1/week","color":"4"},
		{"id":"n61","type":"text","x":712,"y":1720,"width":300,"height":56,"text":"≥3 min  OR  ≥1/week","color":"1"},
		{"id":"n62","type":"text","x":0,"y":1784,"width":380,"height":56,"text":"E. Acting off / not responding (focal impaired)","color":"2"},
		{"id":"n63","type":"text","x":396,"y":1784,"width":300,"height":56,"text":"<3 min  &  <1/week","color":"4"},
		{"id":"n64","type":"text","x":712,"y":1784,"width":300,"height":56,"text":"≥3 min  OR  ≥1/week","color":"1"},
		{"id":"n65","type":"text","x":0,"y":1848,"width":380,"height":56,"text":"F. Other","color":"2"},
