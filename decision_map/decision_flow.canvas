		{"id":"n79","type":"text","x":360,"y":2396,"width":320,"height":120,"text":"Still having seizures AND already some side effects.\n“You know your child best.”\nOpen to increasing dose (side effects may worsen)?","color":"5"},
		{"id":"n80","type":"text","x":0,"y":2566,"width":380,"height":100,"text":"YES — side effects manageable\n→ Option: INCREASE current dose\n(may improve control; watch side effects)","color":"4"},
		{"id":"n81","type":"text","x":720,"y":2566,"width":380,"height":100,"text":"NO — feels like max dose\n→ Option: ADD a second medication\n(complementary mechanisms; lower each dose)","color":"2"},
		{"id":"n82","type":"text","x":360,"y":2696,"width":320,"height":70,"text":"Either path is valid — physician reviews the DRAFT.\nRecommendation never reaches family without sign-off.","color":"6"},
