		{"id":"n73","type":"text","x":0,"y":2142,"width":360,"height":96,"text":"whole_body_danger\nGeneralized T-C, duration ≥3 min → URGENT","color":"1"},
		{"id":"n74","type":"text","x":376,"y":2142,"width":360,"height":96,"text":"escalate_faster\n>3/wk @ 1–3 min  OR  >1/wk @ 1–3 min\n→ increase faster (every 3 days)","color":"2"},
		{"id":"n75","type":"text","x":752,"y":2142,"width":360,"height":96,"text":"continue_ok\nAll <1 min while titrating → stay course","color":"4"},
		{"id":"n76","type":"text","x":1128,"y":2142,"width":360,"height":96,"text":"switch_when_not_helpful\nUnchanged ≥ 4 wks  OR  worse ≥ 2 wks → switch","color":"3"},
