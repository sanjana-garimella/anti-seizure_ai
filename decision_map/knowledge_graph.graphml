<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
<key id="label" for="node" attr.name="label" attr.type="string"/>
<key id="type" for="node" attr.name="type" attr.type="string"/>
<key id="layer" for="node" attr.name="layer" attr.type="long"/>
<key id="detail" for="node" attr.name="detail" attr.type="string"/>
<key id="branch" for="node" attr.name="branch" attr.type="string"/>
<key id="provenance" for="node" attr.name="provenance" attr.type="string"/>
<key id="rel" for="edge" attr.name="rel" attr.type="string"/>
<key id="minor" for="edge" attr.name="minor" attr.type="boolean"/>
<graph edgedefault="directed">
<node id="cat_no_change">
<data key="label">Keep current dose</data>
<data key="type">recommendation</data>
<data key="layer">5</data>
<data key="detail">Engine recommendation: Keep current dose.</data>
</node>
<node id="cat_escalate">
<data key="label">Increase the dose</data>
<data key="type">recommendation</data>
<data key="layer">5</data>
<data key="detail">Engine recommendation: Increase the dose.</data>
</node>
<node id="cat_slower_uptitration">
<data key="label">Increase more slowly</data>
<data key="type">recommendation</data>
<data key="layer">5</data>
<data key="detail">Engine recommendation: Increase more slowly.</data>
</node>
<node id="cat_hold">
<data key="label">Hold at current dose</data>
<data key="type">recommendation</data>
<data key="layer">5</data>
<data key="detail">Engine recommendation: Hold at current dose.</data>
</node>
<node id="cat_lower_dose">
<data key="label">Lower the dose</data>
<data key="type">recommendation</data>
<data key="layer">5</data>
<data key="detail">Engine recommendation: Lower the dose.</data>
</node>
<node id="cat_add_medication">
<data key="label">Add another medicine</data>
<data key="type">recommendation</data>
<data key="layer">5</data>
<data key="detail">Engine recommendation: Add another medicine.</data>
</node>
<node id="cat_switch_medication">
<data key="label">Switch medicine</data>
<data key="type">recommendation</data>
<data key="layer">5</data>
<data key="detail">Engine recommendation: Switch medicine.</data>
</node>
<node id="cat_insufficient_data">
<data key="label">Need more info / defer</data>
<data key="type">recommendation</data>
<data key="layer">5</data>
<data key="detail">Engine recommendation: Need more info / defer.</data>
</node>
<node id="survey">
<data key="label">Between-visit survey</data>
<data key="type">input</data>
<data key="layer">0</data>
<data key="detail">Interval check-in: seizures since last visit? side effects (level)? phase? adherence? duration/frequency? rash? dose goal? (kristen/BetweenVisit_SurveyDraft)</data>
</node>
<node id="branch_bt">
<data key="label">BREAKTHROUGH seizures</data>
<data key="type">branch</data>
<data key="layer">2</data>
<data key="detail">One or more breakthrough seizures this interval.</data>
</node>
<node id="branch_sf">
<data key="label">SEIZURE-FREE</data>
<data key="type">branch</data>
<data key="layer">2</data>
<data key="detail">No seizures this interval.</data>
</node>
<node id="rule_R0">
<data key="label">R0 · Spreading/blistering rash</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Serious skin-reaction concern -&gt; stop + switch; urgent review; family message withheld.

Provenance: Barbour T11/T12 (SJS/TEN)</data>
<data key="branch">safety</data>
<data key="provenance">Barbour T11/T12 (SJS/TEN)</data>
</node>
<node id="rule_R0b">
<data key="label">R0b · Seizure emergency</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Prolonged/repeated seizures -&gt; urgent review; if helping, increase faster; if not helping after min trial -&gt; switch.

Provenance: Barbour T13</data>
<data key="branch">safety</data>
<data key="provenance">Barbour T13</data>
</node>
<node id="rule_R0c">
<data key="label">R0c · Other urgent safety</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Breathing/ER signal -&gt; withhold automated rec; immediate physician review.

Provenance: safety</data>
<data key="branch">safety</data>
<data key="provenance">safety</data>
</node>
<node id="rule_R1">
<data key="label">R1 · Dose changed + seizures</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Regimen recently changed and seizures continue -&gt; confirm regimen, contact clinic (not enough info).

Provenance: Barbour I4</data>
<data key="branch">safety</data>
<data key="provenance">Barbour I4</data>
</node>
<node id="rule_R2">
<data key="label">R2 · Stopped (side effects/cost)</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Family stopped for a switch-worthy reason -&gt; switch to a better-tolerated/feasible option.

Provenance: Barbour T10</data>
<data key="branch">safety</data>
<data key="provenance">Barbour T10</data>
</node>
<node id="rule_R3">
<data key="label">R3 · Drug not indicated</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Drug does not cover the reported seizure type (e.g. ethosuximide = absence only) -&gt; switch.

Provenance: Barbour T14</data>
<data key="branch">safety</data>
<data key="provenance">Barbour T14</data>
</node>
<node id="rule_R4">
<data key="label">R4 · Small rash + SJS workup</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Small rash on an SJS-risk drug + a workup criterion (ancestry/meds/missed doses/time/no viral illness) -&gt; switch.

Provenance: Barbour T11</data>
<data key="branch">safety</data>
<data key="provenance">Barbour T11</data>
</node>
<node id="rule_R4b">
<data key="label">R4b · Can't reach min dose (SE)</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Side effects prevent even a minimum effective dose -&gt; switch.

Provenance: Barbour 2026-06</data>
<data key="branch">safety</data>
<data key="provenance">Barbour 2026-06</data>
</node>
<node id="rule_R5">
<data key="label">R5 · Adherence-driven breakthrough</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Seizures coincide with missed doses -&gt; support adherence before any dose change.

Provenance: adherence</data>
<data key="branch">safety</data>
<data key="provenance">adherence</data>
</node>
<node id="rule_R-defer-se">
<data key="label">R-defer · Unknown SE impact</data>
<data key="type">rule</data>
<data key="layer">1</data>
<data key="detail">Side-effect impact answer not recognized -&gt; physician review (no confident rec).

Provenance: E3 defer-on-ambiguity</data>
<data key="branch">safety</data>
<data key="provenance">E3 defer-on-ambiguity</data>
</node>
<node id="rule_BT">
<data key="label">BT · Breakthrough table</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Action by urgency tier x phase x side-effect level. Levels 1-5 route here (L1 only when duration captured).

Provenance: Barbour 2026-06-25; gate fixed 2026-07-08 (Kristen B1/B2/B3)</data>
<data key="branch">breakthrough</data>
<data key="provenance">Barbour 2026-06-25; gate fixed 2026-07-08 (Kristen B1/B2/B3)</data>
</node>
<node id="rule_R5b">
<data key="label">R5b · Helping but dose-limited</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Medicine helps but side effects block further increases while seizures continue -&gt; ADD a second medicine.

Provenance: Barbour 2026-06</data>
<data key="branch">breakthrough</data>
<data key="provenance">Barbour 2026-06</data>
</node>
<node id="rule_R6">
<data key="label">R6 · Intolerable SE</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Breakthrough + intolerable side effects -&gt; switch.

Provenance: T7 boundary</data>
<data key="branch">breakthrough</data>
<data key="provenance">T7 boundary</data>
</node>
<node id="rule_R7">
<data key="label">R7 · Family prefers slower</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Breakthrough but family prefers a slower/changed dose -&gt; slower uptitration.

Provenance: family preference</data>
<data key="branch">breakthrough</data>
<data key="provenance">family preference</data>
</node>
<node id="rule_R8">
<data key="label">R8 · No SE, no duration</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Breakthrough, no side effects, but duration not captured -&gt; need duration to decide continue vs faster.

Provenance: Barbour T1/T4</data>
<data key="branch">breakthrough</data>
<data key="provenance">Barbour T1/T4</data>
</node>
<node id="rule_R9">
<data key="label">R9 · Frequent/long -&gt; faster</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Frequent and/or long breakthrough -&gt; increase FASTER toward goal (per duration/frequency thresholds).

Provenance: Barbour T1/T4</data>
<data key="branch">breakthrough</data>
<data key="provenance">Barbour T1/T4</data>
</node>
<node id="rule_R10">
<data key="label">R10 · Short/infrequent titrating</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Short/infrequent breakthrough while titrating -&gt; continue the plan (keep increasing on schedule).

Provenance: Barbour T1/T4</data>
<data key="branch">breakthrough</data>
<data key="provenance">Barbour T1/T4</data>
</node>
<node id="rule_R11">
<data key="label">R11 · Below faster thresholds</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Breakthrough below the increase-faster thresholds -&gt; continue the current titration plan.

Provenance: Barbour T1/T4</data>
<data key="branch">breakthrough</data>
<data key="provenance">Barbour T1/T4</data>
</node>
<node id="rule_R12g">
<data key="label">R12g · At goal + medium SE</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">At goal, medium-impact SE, ongoing seizures -&gt; ask family: tolerate &amp; increase, or add a second med.

Provenance: Barbour 2026-06</data>
<data key="branch">breakthrough</data>
<data key="provenance">Barbour 2026-06</data>
</node>
<node id="rule_R12">
<data key="label">R12 · Manageable, no duration</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Breakthrough + manageable SE but no duration -&gt; need duration to weigh increasing vs holding.

Provenance: Barbour</data>
<data key="branch">breakthrough</data>
<data key="provenance">Barbour</data>
</node>
<node id="rule_R13">
<data key="label">R13 · Titrating + medium SE</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Titrating + medium-impact SE -&gt; slow uptitration; reassess after a 1-week adjustment.

Provenance: Barbour 2026-06</data>
<data key="branch">breakthrough</data>
<data key="provenance">Barbour 2026-06</data>
</node>
<node id="rule_NS">
<data key="label">NS · No-Seizures table</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Action by phase x side-effect level when seizure-free. 'Continue' cells schedule no follow-up (Kristen D4).

Provenance: Barbour 2026-06-25; follow-up fixed 2026-07-08 (Kristen D4)</data>
<data key="branch">seizure_free</data>
<data key="provenance">Barbour 2026-06-25; follow-up fixed 2026-07-08 (Kristen D4)</data>
</node>
<node id="rule_R14">
<data key="label">R14 · Free + intolerable SE</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Seizure-free but intolerable side effects -&gt; switch.

Provenance: legacy</data>
<data key="branch">seizure_free</data>
<data key="provenance">legacy</data>
</node>
<node id="rule_R15">
<data key="label">R15 · Family wants different med</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Family would like a different medicine (no clinical trigger) -&gt; offer switch options for physician.

Provenance: family preference</data>
<data key="branch">seizure_free</data>
<data key="provenance">family preference</data>
</node>
<node id="rule_R16">
<data key="label">R16 · Free titrating, family slower</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Seizure-free, titrating, family prefers slower -&gt; slower uptitration.

Provenance: family preference</data>
<data key="branch">seizure_free</data>
<data key="provenance">family preference</data>
</node>
<node id="rule_R17">
<data key="label">R17 · Free + manageable SE</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Seizure-free + manageable side effects -&gt; no change; reassess as body adjusts.

Provenance: legacy</data>
<data key="branch">seizure_free</data>
<data key="provenance">legacy</data>
</node>
<node id="rule_R18">
<data key="label">R18 · Free + no SE</data>
<data key="type">rule</data>
<data key="layer">3</data>
<data key="detail">Seizure-free, no side effects -&gt; no change; recheck on schedule if still titrating.

Provenance: legacy</data>
<data key="branch">seizure_free</data>
<data key="provenance">legacy</data>
</node>
